# FarmDirect Production & Bolt Environment Configuration
# NOTE: Secrets must NEVER be exposed in the frontend or public browser code.
# All secret keys are accessed strictly server-side by the FastAPI backend.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Database Connection (PostgreSQL or local SQLite)
# ─────────────────────────────────────────────────────────────────────────────
# For SQLite local/prototype:
DATABASE_URL=sqlite:///farmdirect.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/farmdirect

# ─────────────────────────────────────────────────────────────────────────────
# 2. AI Voice Assistant Configuration (Multi-lingual Telugu, Hindi, English)
# ─────────────────────────────────────────────────────────────────────────────
# Default farmer language: 'te' (Telugu), 'hi' (Hindi), 'en' (English)
DEFAULT_VOICE_LANGUAGE=te

# Optional Cloud LLM API Keys (Strictly Server-Side for Natural Language Phrasing)
# The system works 100% out-of-the-box using the built-in verified database NLU engine.
# If you configure one of the keys below, the backend grounds its phrasing via that LLM.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Voice Session Timeout (minutes)
VOICE_SESSION_TIMEOUT_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# 3. Official Government of India & Agricultural Market Data APIs
# ─────────────────────────────────────────────────────────────────────────────
# Official Government Open Data Platform (data.gov.in)
DATA_GOV_API_KEY=GOV_IN_API_PROD_VERIFIED_KEY

# Agmarknet / Directorate of Marketing & Inspection (DMI) Feed
AGMARKNET_API_KEY=AGMARKNET_DMI_SECURE_TOKEN

# e-NAM National Agriculture Market API
ENAM_API_KEY=ENAM_NATIONAL_MANDI_KEY

# Resource ID for Daily Mandi Price Feed on data.gov.in
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Application Data Mode: 'false' for Verified Live DB, 'true' for Offline Showcase
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# 4. Server & Security Settings
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
SECRET_KEY=farmdirect_secret_jwt_key_99218
ADMIN_SECRET=farmdirect_admin_secure_pass_2026
